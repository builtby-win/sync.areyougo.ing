# Cloudflare credentials (for drizzle migrations)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=

# Encryption key for IMAP passwords (AES-256, 32 bytes base64 encoded)
ENCRYPTION_KEY=

# Main app URL
MAIN_APP_URL=https://areyougo.ing

# Optional: API key for /api/ingest calls
INGEST_API_KEY=

# Shared secret for sync-projection endpoint auth (must match main app's SYNC_PROJECTION_SECRET)
SYNC_PROJECTION_SECRET=

# Optional: cron schedule for automatic IMAP sync (standard cron syntax)
# Default: */15 * * * * (every 15 minutes)
# Do not set below */5 * * * * (every 5 minutes) for IMAP provider safety
CRON_SCHEDULE=*/15 * * * *
